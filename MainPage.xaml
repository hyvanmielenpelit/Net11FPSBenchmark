<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:local="clr-namespace:Net11FPSBenchmark"
             x:Class="Net11FPSBenchmark.MainPage"
             NavigationPage.HasNavigationBar="False">

    <!-- Root Grid: canvas + UI overlay (same structure as GnollHack's RootGrid > MainGrid + UIGrid) -->
    <Grid>
        <!-- SwitchableCanvasView (GPU-accelerated or CPU depending on UseGL, exact GnollHack logic) -->
        <local:SwitchableCanvasView x:Name="MainCanvasView"
                                    UseGL="True"
                                    PaintSurfaceGL="OnPaintSurfaceGL"
                                    PaintSurface="OnPaintSurface"
                                    Touch="OnTouch" />

        <!-- Elements to simulate GnollHack's visual tree overhead on iOS -->
        <!-- 1. The unused SKCanvasView from SwitchableCanvasView is now built into SwitchableCanvasView itself -->
        <!-- 2. The FadeFrame overlay -->
        <Border x:Name="FadeFrame" IsVisible="False" InputTransparent="True" BackgroundColor="Black" Stroke="Black" Padding="12,12" StrokeThickness="1" StrokeShape="Rectangle" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- UI overlay grid (same 3-row structure as GnollHack's UIGrid) -->
        <Grid x:Name="UIGrid"
              InputTransparent="True"
              CascadeInputTransparent="False"
              RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TOGGLE AND BENCHMARK BUTTONS -->
            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <Button x:Name="ToggleRendererBtn"
                        Text="Renderer: Simple"
                        Padding="10"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="ToggleRendererBtn_Clicked" />
                <Button x:Name="ToggleArrayBottleneckBtn"
                        Text="Array Bottleneck: ON"
                        Padding="10"
                        BackgroundColor="Purple"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="ToggleArrayBottleneckBtn_Clicked" />
                <Button x:Name="ToggleManagedStructBtn"
                        Text="Managed Struct: ON"
                        Padding="10"
                        BackgroundColor="DarkMagenta"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="ToggleManagedStructBtn_Clicked" />
                <Button x:Name="ToggleCanvasTransformBtn"
                        Text="Canvas Transform: ON"
                        Padding="10"
                        BackgroundColor="DarkOrange"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="ToggleCanvasTransformBtn_Clicked" />
                <Button x:Name="ToggleSplitDrawingBtn"
                        Text="Split Drawing: ON"
                        Padding="10"
                        BackgroundColor="DarkCyan"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="ToggleSplitDrawingBtn_Clicked" />
                <Button x:Name="RunArrayBenchmarkBtn"
                        Text="Run Array Benchmark"
                        Padding="10"
                        BackgroundColor="DarkBlue"
                        TextColor="White"
                        InputTransparent="False"
                        Clicked="RunArrayBenchmarkBtn_Clicked" />
            </VerticalStackLayout>

            <!-- ============================================================ -->
            <!-- TOP-RIGHT: Stone-style quick action buttons                   -->
            <!-- (mirrors GnollHack's StoneButtonGrid — each is a              -->
            <!--  GHCachedImage SKCanvasView drawn button)                      -->
            <!-- ============================================================ -->
            <HorizontalStackLayout Grid.Row="0"
                                   x:Name="StoneButtonGrid"
                                   HorizontalOptions="End"
                                   Spacing="6"
                                   Margin="6"
                                   InputTransparent="False">
                <local:CachedImageButton x:Name="StoneMenuBtn"
                    WidthRequest="44" HeightRequest="44" />
                <local:CachedImageButton x:Name="StoneCancelBtn"
                    WidthRequest="44" HeightRequest="44" />
                <local:CachedImageButton x:Name="StoneAutoCenterBtn"
                    WidthRequest="44" HeightRequest="44" />
                <local:CachedImageButton x:Name="StoneMinimapBtn"
                    WidthRequest="44" HeightRequest="44" />
                <local:CachedImageButton x:Name="StoneLookBtn"
                    WidthRequest="44" HeightRequest="44" />
                <local:CachedImageButton x:Name="StoneTravelBtn"
                    WidthRequest="44" HeightRequest="44" />
            </HorizontalStackLayout>

            <!-- ============================================================ -->
            <!-- BOTTOM: Two-row command button bar                            -->
            <!-- (mirrors GnollHack's ButtonRowGrid with UpperCmdGrid          -->
            <!--  and LowerCmdGrid — each button is a CachedImageButton        -->
            <!--  drawn with SkiaSharp, same as GnollHack's GHCachedImage)     -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2"
                  x:Name="ButtonRowGrid"
                  BackgroundColor="#66000000"
                  Padding="4"
                  HorizontalOptions="Fill"
                  VerticalOptions="End"
                  InputTransparent="False">
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="4">
                    <!-- Upper command row (7 buttons, same as GnollHack) -->
                    <HorizontalStackLayout x:Name="UpperCmdRow"
                                           Spacing="4"
                                           HorizontalOptions="Center">
                        <local:CachedImageButton x:Name="BtnInventory"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnSearch"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnWait"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnDropMany"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnChat"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnKick"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnRepeat"
                            WidthRequest="52" HeightRequest="60" />
                    </HorizontalStackLayout>
                    <!-- Lower command row (7 buttons, same as GnollHack) -->
                    <HorizontalStackLayout x:Name="LowerCmdRow"
                                           Spacing="4"
                                           HorizontalOptions="Center">
                        <local:CachedImageButton x:Name="BtnSwap"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnFire"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnThrow"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnCast"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnZap"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnApply"
                            WidthRequest="52" HeightRequest="60" />
                        <local:CachedImageButton x:Name="BtnMore"
                            WidthRequest="52" HeightRequest="60" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- 3. Complex invisible menu overlay (MenuGrid) with its own canvas and frames -->
        <Grid x:Name="MenuGrid" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="#AA000000" IsVisible="False">
            <skia:SKCanvasView x:Name="MenuCanvas" IsVisible="True" HorizontalOptions="Fill" VerticalOptions="Fill" />
            <Border BackgroundColor="#66000000" Stroke="Black" Padding="12,12" StrokeThickness="1" StrokeShape="RoundRectangle 10,10,10,10" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Menu Overlay Simulator" FontSize="20" HorizontalOptions="Center" TextColor="White" />
                    <Picker WidthRequest="180" BackgroundColor="#303030" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
        </Grid>

    </Grid>
</ContentPage>
