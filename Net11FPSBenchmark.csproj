<Project Sdk="Microsoft.NET.Sdk">

	<!-- ================================================================
	     Auto-detect .NET version from the active SDK (set by global.json).
	     Just swap global.json to switch — no need to edit this file.
	     
	     Use switch-dotnet.ps1 10/11 to swap global.json, or do it manually:
	       copy global.net10.json global.json
	       copy global.net11.json global.json
	     ================================================================ -->
	<PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('10.'))">
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<MauiVersion>10.0.90</MauiVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('11.'))">
		<TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks>
		<!-- MauiVersion for .NET 11 is set by the SDK -->
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Net11 FPS Benchmark</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.benchmark.net11fps</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>

		<!-- Disable interpreter globally — we want to benchmark native code performance only -->
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<!-- iOS-specific: force AOT and arm64 -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<RunAOTCompilation>true</RunAOTCompilation>
	</PropertyGroup>

	<!-- iOS codesign -->
	<PropertyGroup Condition="$(TargetFramework.EndsWith('-ios'))">
	  <CodesignKey>Apple Development: Created via API (79X3KBSWAS)</CodesignKey>
	  <CodesignProvision>VS: WildCard Development</CodesignProvision>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net11.0-ios'">
	  <CodesignKey>Apple Development: Created via API (79X3KBSWAS)</CodesignKey>
	  <CodesignProvision>VS: WildCard Development</CodesignProvision>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="SkiaSharp" Version="4.151.0-rc.1.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.0-rc.1.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Core" Version="4.151.0-rc.1.1" />
	</ItemGroup>

	<!-- Tile sheet asset — do NOT compress PNGs, they are used as-is by SkiaSharp -->
	<ItemGroup>
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Print active SDK/.NET version at build start -->
	<Target Name="PrintVersionInfo" BeforeTargets="Build">
		<Message Importance="high" Text="========================================" />
		<Message Importance="high" Text="  SDK Version:    $(NETCoreSdkVersion)" />
		<Message Importance="high" Text="  Target:         $(TargetFramework)" />
		<Message Importance="high" Text="  MAUI Version:   $(MauiVersion)" />
		<Message Importance="high" Text="========================================" />
	</Target>

</Project>
